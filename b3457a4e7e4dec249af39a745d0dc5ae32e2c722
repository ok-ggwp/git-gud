        ],
        "notes": "Codex is wired up but has not run live: it isn't logged in on this machine. Its flags come from codex exec --help (0.149.1)."
      },
      {
        "id": "outer-sandbox",
        "intent": "A bubblewrap sandbox for Codex and Cursor, probed before each run",
        "necessity": "required",
        "serves": "agents",
        "removal_impact": "Codex and Cursor reviewers would run with full access to the home directory and filesystem: Cursor's --sandbox enabled read ~, wrote /var/tmp and reached the network in testing",
        "evidence": "Tested: home shows nothing but the binds inside, a write to /var/tmp fails, SSH_AUTH_SOCK is cleared, the workspace is writable, and a sandbox that lets writes out is refused. The probe runs in tests and in `git gud agents`.",
        "hunks": [
