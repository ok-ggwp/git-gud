        "necessity": "required",
        "serves": "direct-runs",
        "removal_impact": "the mode couldn't be chosen, extra arguments couldn't be set, and a direct reviewer would be told it's in a sandbox",
        "hunks": [
          "h15",
          "h16",
          "h17",
          "h18",
          "h19"
